# 复制成 .env 再填自己的 key
# .env 已经在 .gitignore 里，不会进 git

# ---- Chat 模型（生成答案 / 查询改写 / 评测裁判）----
# 和 M1 用的是同一批环境变量名，可直接从 M1 的 .env 抄过来
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=

# ---- Embedding 模型（向量化）----
# ⚠️ DeepSeek 没有 embedding 模型，所以必须单独配一个
# 选项 A：阿里云百炼 DashScope（推荐，OpenAI 兼容端点）
DASHSCOPE_API_KEY=

# ---- 日志 ----
LLM_LOG_LEVEL=INFO
